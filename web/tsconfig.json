{
  "compilerOptions": {
    "target": "ES2022",
    "lib": [
      "ES2023",
      "DOM",
      "DOM.Iterable"
    ],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "skipLibCheck": true,
    "noEmit": true,
    "types": [
      "vite/client",
      "node"
    ],
    "allowJs": true,
    "checkJs": true,
    "paths": {
      "@design/*": [
        "../replica/design/*"
      ],
      "@pcci": [
        "../replica/pcci.json"
      ],
      "@referentiels": [
        "../replica/referentiels.json"
      ],
      "@etats": [
        "../replica/etats-pcci.json"
      ],
      "@liasse": [
        "../replica/liasse-pcci.json"
      ],
      "@localisation": [
        "../replica/localisation-rdc.json"
      ],
      "@demonstration": [
        "../replica/demonstration.json"
      ],
      "@reportingLcb": [
        "../replica/reporting-lcb.json"
      ]
    }
  },
  "include": [
    "src",
    "vite.config.ts",
    "../replica/design/montant.js",
    "../replica/pcci.json",
    "../replica/referentiels.json",
    "../replica/localisation-rdc.json",
    "../replica/demonstration.json"
  ]
}